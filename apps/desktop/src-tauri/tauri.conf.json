{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge Desktop",
  "version": "0.1.0",
  "identifier": "dev.forge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @forge/desktop",
    "beforeBuildCommand": "npm run build --workspace @forge/desktop",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forge Desktop",
        "width": 1400,
        "height": 900
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
