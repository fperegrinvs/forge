{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge Desktop",
  "version": "0.1.0",
  "identifier": "dev.forge.desktop",
  "build": {
    "beforeBuildCommand": "bun --cwd .. run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "http://127.0.0.1:1420/",
        "title": "Forge Desktop",
        "width": 1400,
        "height": 900
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
