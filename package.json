{
  "name": "forge-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preflight": "./scripts/bootstrap-toolchain.sh --check",
    "hooks:install": "./scripts/install-githooks.sh",
    "workflow:sync": "bun scripts/sync-workflow-assets.mjs",
    "workflow:check-sync": "bun scripts/check-workflow-sync.mjs",
    "workflow:check": "bun run --filter @forge/cli build && bun packages/cli/dist/bin.js workflow check --plan plans/forge-monorepo-v1.plan.json",
    "build": "bun run --workspaces build --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:desktop": "vitest run apps/desktop/src/**/*.test.ts",
    "verify": "bun run workflow:check-sync && bun run docs:check && bun run typecheck && bun run lint && bun run architecture:check && bun run test:coverage && bun run workflow:check",
    "dev:desktop": "bun run --filter @forge/desktop dev",
    "docs:check": "bun scripts/docs-check.mjs",
    "architecture:check": "bun scripts/architecture-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.22.0",
    "eslint-plugin-import": "^2.31.0",
    "jiti": "^2.6.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.8"
  }
}
