{
  "name": "forge-app-template",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "dev": "echo 'configure app dev scripts'",
    "test": "echo 'configure app tests'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'configure lint rules'",
    "docs:check": "node scripts/docs-check.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "gate:green": "bun run test && bun run typecheck && bun run lint",
    "gate:architecture": "bun run architecture:check",
    "gate:docs": "bun run docs:check",
    "workflow:check": "bun run gate:green && bun run gate:architecture && bun run gate:docs"
  }
}
