#!/usr/bin/env bash
set -euo pipefail

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [[ "$branch" == "main" ]]; then
  echo "ERROR: direct pushes to 'main' are not allowed. Create a codex/* branch and open a PR." >&2
  exit 1
fi

if [[ "${FORGE_SKIP_PREPUSH:-}" == "1" ]]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${repo_root}"

mode="${FORGE_PREPUSH_MODE:-typecheck}" # typecheck|verify

run_typecheck() {
  if command -v bun >/dev/null 2>&1; then
    bun run typecheck
    return
  fi

  if [[ -x "node_modules/.bin/tsc" ]]; then
    node_modules/.bin/tsc -b
    return
  fi

  if command -v tsc >/dev/null 2>&1; then
    tsc -b
    return
  fi

  echo "ERROR: typecheck requires bun or node_modules (tsc). Set FORGE_SKIP_PREPUSH=1 to bypass." >&2
  exit 1
}

if [[ "${mode}" == "verify" ]]; then
  if command -v bun >/dev/null 2>&1; then
    bun run verify
  else
    echo "ERROR: FORGE_PREPUSH_MODE=verify requires bun. Set FORGE_PREPUSH_MODE=typecheck to run only tsc." >&2
    exit 1
  fi
else
  run_typecheck
fi
